# Stackific OS artwork for Arch: the wallpapers with their credits, and fastfetch with our logo (so installing the
# branding installs fastfetch). The sources are base-neutral files from branding/, which `just arch packages` stages
# next to this file by name. The paintings are public domain (nine CC0, one without a named licence); wallpapers.toml
# credits each one and serves as their licence file.
# shellcheck disable=SC2034,SC2154

pkgname=stackific-artwork
pkgver=0.1.0
pkgrel=1
pkgdesc='Stackific OS artwork: the wallpapers, and fastfetch with the Stackific OS logo'
arch=('any')
url='https://os.stackific.com'
license=('Apache-2.0' 'CC0-1.0' 'LicenseRef-PublicDomain')
makedepends=('gettext')
depends=('fastfetch')
options=('!debug' '!strip')
backup=('etc/xdg/fastfetch/config.jsonc')
_wallpapers=(
  'an-eruption-of-vesuvius-johan-christian-dahl.jpg'
  'festoon-of-fruits-johannes-borman.jpg'
  'fog-effect-camille-pissarro.jpg'
  'pines-along-the-shore-henri-edmond-cross.jpg'
  'still-life-with-a-gilt-cup-willem-claesz-heda.jpg'
  'sunset-after-a-storm-andreas-achenbach.jpg'
  'the-north-cape-by-moonlight-peder-balke.jpg'
  'twilight-in-the-wilderness-frederic-edwin-church.jpg'
  'view-from-mount-holyoke-thomas-cole.jpg'
  'wheat-field-with-cypresses-vincent-van-gogh.jpg'
)
source=('branding.env' 'fastfetch.jsonc.in' 'logo.txt' 'wallpapers.toml' "${_wallpapers[@]}")
sha256sums=('985affad12bfb221a563ef41d9a31b9b0b7fe0c103f4ce6be7ddd68c3a849759'
