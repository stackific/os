# Render fastfetch's config with the accent from branding.env
build() {
  set -a
  # shellcheck source=/dev/null # staged next to this file at build time
  . ./branding.env
  set +a
  # shellcheck disable=SC2016 # envsubst takes the variable name literally
  envsubst '$ACCENT' <fastfetch.jsonc.in >fastfetch.jsonc
}

# Install the wallpapers and their credits, the text logo, and fastfetch's system-wide config
package() {
  install -Dm644 -t "$pkgdir/usr/share/backgrounds/stackific" "${_wallpapers[@]}"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" wallpapers.toml
  install -Dm644 -t "$pkgdir/usr/share/stackific" logo.txt
  install -Dm644 fastfetch.jsonc "$pkgdir/etc/xdg/fastfetch/config.jsonc"
}
