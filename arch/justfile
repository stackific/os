# Arch module: builds the Arch live ISO for the host's architecture (x86_64, or aarch64 from Arch Linux ARM) in the
# pinned builder container and boot-tests it under QEMU with UEFI firmware (OVMF or AAVMF). Pins live in vars.just;
# outputs go to .build/arch/<arch>/. Image builds need Linux with rootless podman.

import 'vars.just'
import '../tests/vars.just'

# Build the pinned builder image (podman's layer cache makes a rebuild with unchanged pins a no-op)
builder:
  @podman build --quiet --build-arg BASE={{ builder_base }} --build-arg ALA_DATE={{ replace(ala_date, '-', '/') }} \
    --tag {{ builder }} --file "{{ justfile_directory() }}/arch/Containerfile" "{{ justfile_directory() }}/arch" >/dev/null

# Build our packages (arch/packages/*/PKGBUILD) with makepkg in a fresh builder container into the local repo
# .build/arch/repo/ (unsigned until release signing). Local sources come from the package's own folder (an Arch-only
# file), desktop/, branding/, hardware/ and installer/ (never its target/), staged by file name; the installer's crate
# is packed into stackific-installer-crate.tar.
# SELinux (Fedora, as in the Mac's runner VM) hides bind mounts from containers unless labelling is off; without
# SELinux it is a no-op. The --privileged ISO build has labelling off already.
packages: builder
  #!/usr/bin/env bash
  set -euo pipefail
  rm -rf "{{ repo }}"
  mkdir -p "{{ repo }}"
  podman run --rm --security-opt label=disable \
    --volume "{{ justfile_directory() }}/arch/packages:/packages:ro" \
    --volume "{{ justfile_directory() }}/desktop:/desktop:ro" --volume "{{ justfile_directory() }}/branding:/branding:ro" \
    --volume "{{ justfile_directory() }}/hardware:/hardware:ro" \
    --volume "{{ justfile_directory() }}/installer:/installer:ro" --volume "{{ repo }}:/repo" \
    --env SOURCE_DATE_EPOCH="$(git -C "{{ justfile_directory() }}" log -1 --format=%ct)" \
    {{ builder }} bash -c 'set -euo pipefail
      for p in /packages/*/PKGBUILD; do
        b=/home/build/pkg/$(basename "$(dirname "$p")")
        mkdir -p "$b"
        cp "$p" "$b/"
        for f in $(source "$p"; echo "${source[@]}"); do
          find "$(dirname "$p")" /desktop /branding /hardware /installer -path /installer/target -prune -o -type f -name "$f" \
            -exec cp -t "$b" {} +
        done
        if [ "$(basename "$b")" = stackific-installer ]; then
          tar -C /installer --sort=name --mtime="@$SOURCE_DATE_EPOCH" --owner=0 --group=0 --numeric-owner \
            -cf "$b/stackific-installer-crate.tar" Cargo.toml Cargo.lock src fixtures
        fi
        chown -R build "$b"
        (cd "$b" && runuser -u build -- makepkg --nodeps)
        cp "$b"/*.pkg.tar.* /repo/
      done
      repo-add -q /repo/stackific.db.tar.zst /repo/*.pkg.tar.*'

# Build .build/arch/<arch>/stackific-<version>-arch-<arch>.iso and its package manifest, then print the ISO size
[positional-arguments]
iso version="0.0.0-dev": packages
  #!/usr/bin/env bash
  set -euo pipefail
  # The version reaches file names and the container only as data ($1, env), and must be semver like a release
  [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || { echo "version must be semver, got '$1'" >&2; exit 1; }
  name="stackific-$1-arch-{{ arch() }}"
  mkdir -p "{{ out }}" "{{ pkgcache }}"
  rm -f "{{ out }}/$name.iso" "{{ out }}/$name.packages.txt"
  # mkarchiso runs as `build` with its work dir inside the container, so --rm discards it and every build starts fresh.
  # Container root (the host user) then moves the outputs to /out, so the host user owns them.
  # The package cache is the host's, so a build downloads only what changed since the last one: archive.archlinux.org
  # stalls now and then, and every download it skips is one fewer chance to fail. `build` must own it, or mkarchiso
  # falls back to /tmp; container root (the host user) takes it back on exit, so the host user can delete it.
  # Arch Linux ARM keeps some packages (libpisp, which libcamera needs) in its own [alarm] repo, which Arch's archive
  # lacks, so only aarch64 builds add it to the profile's pacman.conf.
  podman run --rm --privileged \
    --volume "{{ justfile_directory() }}/arch/iso:/profile:ro" --volume "{{ repo }}:/repo:ro" --volume "{{ out }}:/out" \
    --volume "{{ pkgcache }}:/var/cache/pacman/pkg" \
    --env STACKIFIC_VERSION="$1" --env NAME="$name" \
    --env SOURCE_DATE_EPOCH="$(git -C "{{ justfile_directory() }}" log -1 --format=%ct)" \
    {{ builder }} bash -c 'trap "chown -R root: /var/cache/pacman/pkg" EXIT; chown build: /var/cache/pacman/pkg \
      && cp -r /profile /home/build/profile \
      && if [ "{{ arch() }}" = aarch64 ]; then printf "\n[alarm]\nInclude = /etc/pacman.d/mirrorlist\n" >>/home/build/profile/pacman.conf; fi \
      && runuser -u build -- mkarchiso -v -w /home/build/work -o /home/build/out /home/build/profile \
      && install -m644 "/home/build/out/$NAME.iso" /out/ \
      && install -m644 /home/build/work/iso/arch/pkglist.{{ arch() }}.txt "/out/$NAME.packages.txt"'
  mib=$(( $(stat -c %s "{{ out }}/$name.iso") / 1048576 ))
  [ "$mib" -le 2048 ] || echo "warning: ISO is over the 2 GiB target (GitHub's per-file release cap)"
  echo "ISO: {{ out }}/$name.iso, $mib MiB (target 2048 MiB)"

# Boot-test stackific-<version>-arch-<arch>.iso under QEMU with UEFI firmware (tests/vm/boot.sh with
# tests/vm/arch-<arch>.sh when the architecture has its own checks, else tests/vm/arch.sh, the checks both Arch images
# pass); leaves serial.log, screen.png, greeter.png and plasma.png
# podman's default seccomp profile blocks AF_VSOCK sockets, which the test shell client needs. SELinux also keeps
# containers off /dev/vhost-vsock unless labelling is off (see packages).
[positional-arguments]
test version="0.0.0-dev": builder
  #!/usr/bin/env bash
  set -euo pipefail
  checks=arch.sh
  [ ! -f "{{ justfile_directory() }}/tests/vm/arch-{{ arch() }}.sh" ] || checks="arch-{{ arch() }}.sh"
  podman run --rm --device /dev/kvm --device /dev/vhost-vsock --security-opt seccomp=unconfined \
    --security-opt label=disable \
    --volume "{{ justfile_directory() }}/tests/vm:/tests:ro" --volume "{{ out }}:/out" \
    {{ builder }} /tests/boot.sh "/out/stackific-$1-arch-{{ arch() }}.iso" /out "/tests/$checks"

# Test the installer on stackific-<version>-arch-<arch>.iso: the boot menu's entries (read with bsdtar, never a
# mount), then one boot with a fresh 64 GiB raw disk (tests/vm/boot.sh with tests/vm/install.sh: the console path, an
# erase, BIOS-mode Windows refused, BitLocker and a fake Windows on a Windows-like table, and a free-space install,
# unattended; cryptsetup's BitLocker images pinned in tests/vars.just), then the free-space install's ESP, read from the image with minfo
# (mtools). Then the installed system boots from the disk alone, with the first boot's firmware variables
# (tests/vm/installed.sh), its LUKS2 root unlocked by the passphrase credential; mcopy puts the builder's limine package (the archive date's on x86_64, Arch Linux ARM's current one on aarch64) at its ESP's
# root for the hook check. pacman's sandbox fails in rootless podman, so the download runs without it. The disk image is
# removed after a pass and kept after a failure. A last boot types at the passphrase prompt (tests/vm/unlock.sh): three
# wrong passphrases, the boot-failure screen, Enter, then the password (tests/vars.just) on the German layout.
[positional-arguments]
test-install version="0.0.0-dev": builder
  #!/usr/bin/env bash
  set -euo pipefail
  podman run --rm --device /dev/kvm --device /dev/vhost-vsock --security-opt seccomp=unconfined \
    --security-opt label=disable \
    --volume "{{ justfile_directory() }}/tests/vm:/tests:ro" --volume "{{ out }}:/out" \
    --env ISO="/out/stackific-$1-arch-{{ arch() }}.iso" --env STACKIFIC_TEST_DISK=/out/install-test.img \
    --env BITLK_IMAGES_URL={{ bitlk_images_url }} --env BITLK_IMAGES_SHA256={{ bitlk_images_sha256 }} \
    --env STACKIFIC_TEST_PASSWORD="{{ test_password }}" \
    {{ builder }} bash -c 'set -euo pipefail
      entry() { bsdtar -xOf "$ISO" "loader/$1" | grep -qx -- "$2" || { echo "FAIL: loader/$1 has no line /$2/" >&2; exit 1; }; }
      entry entries/01-stackific-linux.conf "title   Try Stackific OS ({{ arch() }}, UEFI)"
      entry entries/02-stackific-install.conf "title   Install Stackific OS ({{ arch() }}, UEFI)"
      entry entries/02-stackific-install.conf "options .* systemd.unit=stackific-installer.target"
      entry loader.conf "default 01-stackific-linux.conf"
      echo "ok: the boot menu has Try (the default) and Install"
      rm -f "$STACKIFIC_TEST_DISK" /out/esp-offset
      qemu-img create -q -f raw "$STACKIFIC_TEST_DISK" 64G
      /tests/boot.sh "$ISO" /out /tests/install.sh
      minfo -i "$STACKIFIC_TEST_DISK@@$(cat /out/esp-offset)" | grep -q "FAT32" || { echo "FAIL: no FAT32 at the ESP offset" >&2; exit 1; }
      echo "ok: the free-space install'"'"'s ESP is FAT32"
      rm -rf /out/pkg && mkdir /out/pkg
      pacman -Sw --noconfirm --disable-sandbox --cachedir /out/pkg limine >/dev/null
      rm -f /out/pkg/*.sig # the package alone: pacman -U on the installed system checks it against its own keyring
      mcopy -i "$STACKIFIC_TEST_DISK@@$(cat /out/esp-offset)" /out/pkg/limine-*.pkg.tar.* ::/
      STACKIFIC_TEST_PASSPHRASE="$STACKIFIC_TEST_PASSWORD" OVMF_VARS=/out/vars.fd /tests/boot.sh - /out /tests/installed.sh
      OVMF_VARS=/out/vars.fd PREBOOT=/tests/unlock.sh /tests/boot.sh - /out /dev/null
      rm -rf "$STACKIFIC_TEST_DISK" /out/pkg'

# Screenshots of the installer's screens for the prompt trail: one boot of stackific-<version>-arch-<arch>.iso with a
# fresh 64 GiB disk (tests/vm/boot.sh with tests/vm/screens.sh), the real installer driven by key presses on the
# desktop and on the console. The PNGs land in .build/arch/<arch>/screens/, for `just site screenshot`. Not part of CI.
[positional-arguments]
screenshots version="0.0.0-dev": builder
  #!/usr/bin/env bash
  set -euo pipefail
  podman run --rm --device /dev/kvm --device /dev/vhost-vsock --security-opt seccomp=unconfined \
    --security-opt label=disable \
    --volume "{{ justfile_directory() }}/tests/vm:/tests:ro" --volume "{{ out }}:/out" \
    --env ISO="/out/stackific-$1-arch-{{ arch() }}.iso" --env STACKIFIC_TEST_DISK=/out/screens-test.img \
    --env BITLK_IMAGES_URL={{ bitlk_images_url }} --env BITLK_IMAGES_SHA256={{ bitlk_images_sha256 }} \
    {{ builder }} bash -c 'set -euo pipefail
      rm -rf /out/screens "$STACKIFIC_TEST_DISK"
      qemu-img create -q -f raw "$STACKIFIC_TEST_DISK" 64G
      /tests/boot.sh "$ISO" /out /tests/screens.sh
      rm -f "$STACKIFIC_TEST_DISK"
      ls /out/screens'

# Check the host prerequisites image builds need: rootless podman, and read-write /dev/kvm and /dev/vhost-vsock
check:
  #!/usr/bin/env bash
  set -euo pipefail
  if [ "{{ os() }}" = macos ]; then echo "arch: skipped (image builds need Linux)"; exit 0; fi
  v=$(podman --version 2>/dev/null) || { echo "arch: podman missing (docs/setup.md, host prerequisites)"; exit 1; }
  for d in /dev/kvm /dev/vhost-vsock; do
    [ -r "$d" ] && [ -w "$d" ] || { echo "arch: $d is not read-write for $USER (docs/setup.md, host prerequisites)"; exit 1; }
  done
  echo "arch: ok (podman ${v##* }, /dev/kvm and /dev/vhost-vsock read-write)"
