# Starts the Noctalia shell in MangoWM sessions; shipped by the package stackific-desktop.
# Glue, because no packaged piece does it: Noctalia ships no unit, and MangoWM's stock config does not start it.
# MangoWM imports WAYLAND_DISPLAY into the user manager, then starts mango-session.target itself, so wanting this unit
# there starts Noctalia with MangoWM's config left as packaged. Plasma never starts that target.
[Unit]
Description=Noctalia desktop shell
Documentation=https://docs.noctalia.dev
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/noctalia
Restart=on-failure
# Noctalia can hang on SIGTERM while a Secret Service prompt it asked for is pending (a session with no password,
# whose keyring stays locked: the live user); without this, logout and shutdown wait systemd's 90 s for it
TimeoutStopSec=5s

[Install]
WantedBy=mango-session.target
