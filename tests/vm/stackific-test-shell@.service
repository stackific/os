# One test shell connection: reads one line and runs bash on the connection only when the line is this boot's token,
# which boot.sh passes as the stackific.test.token credential. A wrong or empty line (an empty one would match a missing
# credential) closes the connection without a shell; the instance still succeeds, so a rejected probe never marks the
# system degraded.
[Unit]
Description=Stackific test shell connection

[Service]
ImportCredential=stackific.test.token
StandardInput=socket
StandardOutput=socket
StandardError=socket
ExecStart=/usr/bin/bash -c 'IFS= read -r t; [ -n "$$t" ] && [ "$$t" = "$$(< "$$CREDENTIALS_DIRECTORY/stackific.test.token")" ] || exit 0; exec /usr/bin/bash'
