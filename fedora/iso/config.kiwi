<?xml version="1.0" encoding="utf-8"?>
<!-- kiwi description of the Stackific OS desktop live ISO on Fedora 45 x86_64 and aarch64 (`just fedora iso`).
     The build host's architecture picks the image; a package with an arch attribute goes only into that image. -->
<image schemaversion="8.5" name="stackific" displayname="Stackific OS">
  <description type="system">
    <author>Stackific OS</author>
    <contact>https://os.stackific.com</contact>
    <specification>Stackific OS desktop live ISO, Fedora 45 base, x86_64 and aarch64</specification>
  </description>
  <preferences>
    <!-- Unused: `just fedora iso` names the outputs with its own version -->
    <version>0.0.0</version>
    <packagemanager>dnf5</packagemanager>
    <release-version>45</release-version>
    <locale>en_US</locale>
    <keytable>us</keytable>
    <timezone>UTC</timezone>
    <!-- UEFI only, no shim (Secure Boot is off). GRUB, because kiwi's systemd-boot ISO path needs a loop device.
         Both serial consoles, ttyS0 (x86_64) and ttyAMA0 (aarch64): the kernel ignores the one the machine lacks.
         edit-boot.sh adds the Install entry to the boot menu. The volume ID differs from the installed ESP's FAT
         label (STACKIFIC): the live initramfs finds the ISO by label (root=live:CDLABEL=), and with a drive the
         installer wrote attached it would otherwise pick that ESP. -->
    <type image="iso" primary="true" flags="dmsquash" filesystem="erofs" erofscompression="lzma,level=6"
          editbootconfig="edit-boot.sh"
          firmware="efi" eficsm="false" efiparttable="gpt" efifatimagesize="30" mediacheck="false"
          volid="STACKIFIC_LIVE" publisher="Stackific OS" application_id="Stackific OS Live (Fedora base)"
          kernelcmdline="console=ttyS0,115200 console=ttyAMA0,115200 console=tty0">
      <bootloader name="grub2" timeout="3"/>
    </type>
  </preferences>
  <repository type="rpm-md" alias="fedora" sourcetype="metalink" package_gpgcheck="true">
    <source path="https://mirrors.fedoraproject.org/metalink?repo=fedora-$releasever&amp;arch=$basearch">
      <signing key="file:///usr/share/pki/rpm-gpg/RPM-GPG-KEY-fedora-$releasever-primary"/>
    </source>
  </repository>
  <repository type="rpm-md" alias="updates" sourcetype="metalink" package_gpgcheck="true">
    <source path="https://mirrors.fedoraproject.org/metalink?repo=updates-released-f$releasever&amp;arch=$basearch">
      <signing key="file:///usr/share/pki/rpm-gpg/RPM-GPG-KEY-fedora-$releasever-primary"/>
    </source>
  </repository>
  <!-- Terra supplies only mangowm, noctalia-greeter and limine (terra-repo.sh appends includepkgs and gpgkey to its repo
       file).
       Packages and metadata are checked against Terra 45's key, committed next to this file. -->
  <repository type="rpm-md" alias="terra" package_gpgcheck="true" repository_gpgcheck="true" customize="terra-repo.sh">
    <source path="https://repos.fyralabs.com/terra$releasever">
      <signing key="file:///desc/terra-45.asc"/>
    </source>
  </repository>
  <!-- RPM Fusion nonfree supplies only NVIDIA's driver (rpmfusion-repo.sh appends includepkgs and gpgkey); its packages
       are checked against RPM Fusion's Fedora key, committed next to this file. Its metadata is unsigned. The kernel
       modules come from our repo (`just fedora packages` builds kmod-nvidia-<kernel>). The aarch64 image installs none
       of it yet (task 022). -->
  <repository type="rpm-md" alias="rpmfusion-nonfree" sourcetype="metalink" package_gpgcheck="true"
              customize="rpmfusion-repo.sh">
    <source path="https://mirrors.rpmfusion.org/metalink?repo=nonfree-fedora-$releasever&amp;arch=$basearch">
      <signing key="file:///desc/rpmfusion-nonfree-45.asc"/>
    </source>
  </repository>
  <repository type="rpm-md" alias="rpmfusion-nonfree-updates" sourcetype="metalink" package_gpgcheck="true"
              customize="rpmfusion-repo.sh">
    <source path="https://mirrors.rpmfusion.org/metalink?repo=nonfree-fedora-updates-released-$releasever&amp;arch=$basearch">
      <signing key="file:///desc/rpmfusion-nonfree-45.asc"/>
    </source>
  </repository>
  <!-- Our RPMs from `just fedora packages`, mounted at /repo; unsigned until release signing -->
  <repository type="rpm-md" alias="stackific">
    <source path="dir:///repo"/>
  </repository>
  <!-- stackific-release, not fedora-release: Fedora's trademark guidelines require a remix to leave out fedora-release,
       fedora-logos and fedora-release-notes. stackific-release replaces generic-release and provides system-release, so
       naming it here keeps dnf from picking fedora-release. -->
  <packages type="bootstrap">
    <package name="filesystem"/>
    <package name="stackific-release"/>
  </packages>
  <!-- Named packages only: kiwi installs no weak dependencies (patternType onlyRequired). -->
  <packages type="image">
    <package name="kernel"/>
    <package name="kernel-modules-extra"/>
    <package name="systemd"/>
    <!-- Only a Recommends of systemd; without it login opens no logind session -->
    <package name="systemd-pam"/>
    <package name="systemd-udev"/>
    <package name="dracut-live"/>
    <!-- GRUB for the image's architecture. kiwi's ISO builder reads its modules (x86_64-efi or arm64-efi) from the
         image root. -->
    <package name="grub2-efi-x64" arch="x86_64"/>
    <package name="grub2-efi-x64-cdboot" arch="x86_64"/>
    <package name="grub2-efi-x64-modules" arch="x86_64"/>
    <package name="grub2-efi-aa64" arch="aarch64"/>
    <package name="grub2-efi-aa64-cdboot" arch="aarch64"/>
    <package name="grub2-efi-aa64-modules" arch="aarch64"/>
    <!-- linux-firmware and the default firmware of Fedora's hardware-support group (no server or datacenter NICs) -->
    <package name="linux-firmware"/>
    <package name="alsa-sof-firmware"/>
    <package name="amd-gpu-firmware"/>
    <package name="atheros-firmware"/>
    <package name="brcmfmac-firmware"/>
    <package name="cirrus-audio-firmware"/>
    <package name="intel-audio-firmware"/>
    <package name="intel-gpu-firmware"/>
    <package name="intel-vsc-firmware"/>
    <package name="iwlegacy-firmware"/>
    <package name="iwlwifi-dvm-firmware"/>
    <package name="iwlwifi-mvm-firmware"/>
    <package name="libertas-firmware"/>
    <package name="mt7xxx-firmware"/>
    <package name="nvidia-gpu-firmware"/>
    <package name="nxpwireless-firmware"/>
    <package name="qcom-wwan-firmware"/>
    <package name="realtek-firmware"/>
    <package name="tiwilink-firmware"/>
    <!-- Firmware parity with Arch (task 021): old sound cards and TV tuners -->
    <package name="alsa-firmware"/>
    <package name="dvb-firmware"/>
    <!-- x86 CPU microcode: Fedora has no microcode_ctl on aarch64, and AMD's microcode is for x86 CPUs only -->
    <package name="amd-ucode-firmware" arch="x86_64"/>
    <package name="microcode_ctl" arch="x86_64"/>
    <!-- dnf5, so installed systems can update (the live image's GRUB is removed from them by the installer) -->
    <package name="dnf5"/>
    <package name="NetworkManager"/>
    <package name="btrfs-progs"/>
    <package name="dosfstools"/>
    <package name="selinux-policy-targeted"/>
    <package name="passwd"/>
    <package name="util-linux"/>
    <package name="procps-ng"/>
    <!-- <locale>en_US</locale> needs the en_US.UTF-8 locale installed -->
    <package name="glibc-langpack-en"/>
    <package name="kbd"/>
    <!-- Weak dependencies kept because users commonly need them (the rest are left out; task 003 lists both):
         time zones, passwd's dictionary check, and firmware for the NPU in Intel Core Ultra laptops -->
    <package name="tzdata"/>
    <package name="cracklib-dicts"/>
    <package name="intel-npu-firmware"/>
    <!-- gdm (a requirement of gnome-shell) requires system-logos; generic-logos keeps dnf from picking fedora-logos -->
    <package name="generic-logos"/>
    <!-- Our desktop defaults and artwork (the Noctalia unit, wlroots and greeter settings, wallpapers, fastfetch) -->
    <package name="stackific-desktop"/>
    <package name="stackific-artwork"/>
    <!-- The installer and Limine's boot files, named so that removing the installer from an installed system keeps them
         (and limine and efibootmgr, which they require) -->
    <package name="stackific-installer"/>
    <package name="stackific-boot"/>
    <!-- Snapshots and swap (task 026): snapper, btrfs-assistant, the dnf5 actions plugin's pre and post snapshots and
         zram, from stackific-storage's requires -->
    <package name="stackific-storage"/>
    <!-- NVIDIA (task 020): stackific-hardware picks NVIDIA's open modules or nouveau at every boot; the driver from RPM
         Fusion and its open kernel modules from our repo (nvidia-kmod, provided by kmod-nvidia-<kernel>). x86_64 only:
         RPM Fusion's aarch64 xorg-x11-drv-nvidia-libs 615.78.08 requires libnvidia-rmapi-tegra.so, which no package
         ships (task 022) -->
    <package name="stackific-hardware" arch="x86_64"/>
    <package name="xorg-x11-drv-nvidia" arch="x86_64"/>
    <package name="xorg-x11-drv-nvidia-libs" arch="x86_64"/>
    <package name="nvidia-kmod" arch="x86_64"/>
    <!-- Disks, the partition editor, with NTFS mounting and resizing (ntfsresize) for shrinking Windows' partition -->
    <package name="gnome-disk-utility"/>
    <package name="ntfs-3g"/>
    <package name="ntfsprogs"/>
    <!-- MangoWM with Noctalia, and foot and rofi, which MangoWM's stock keybinds launch -->
    <package name="mangowm"/>
    <package name="noctalia"/>
    <package name="foot"/>
    <package name="rofi"/>
    <!-- The display manager and its login screen -->
    <package name="greetd"/>
    <package name="noctalia-greeter"/>
    <!-- GNOME, the second session, with its terminal and file manager -->
    <package name="gnome-shell"/>
    <package name="gnome-session-wayland-session"/>
    <package name="ptyxis"/>
    <package name="nautilus"/>
    <!-- Portals: GNOME's for GNOME, GTK's and wlr's for MangoWM (mango-portals.conf) -->
    <package name="xdg-desktop-portal-gnome"/>
    <package name="xdg-desktop-portal-gtk"/>
    <package name="xdg-desktop-portal-wlr"/>
    <!-- Sound -->
    <package name="pipewire"/>
    <package name="pipewire-pulseaudio"/>
    <package name="wireplumber"/>
    <!-- Regular hardware (task 021): MIPI webcams through libcamera and PipeWire, Thunderbolt and USB4 authorisation,
         fingerprint readers (fprintd without fprintd-pam: no PAM stack uses the reader) -->
    <package name="libcamera"/>
    <package name="libcamera-ipa"/>
    <package name="pipewire-plugin-libcamera"/>
    <package name="pipewire-v4l2"/>
    <package name="bolt"/>
    <package name="fprintd"/>
    <!-- Weak dependencies kept for the desktop (task 008): Wi-Fi, which NetworkManager alone lacks on Fedora, and
         GNOME's UI and monospace fonts -->
    <package name="NetworkManager-wifi"/>
    <package name="wpa_supplicant"/>
    <package name="wireless-regdb"/>
    <package name="adwaita-sans-fonts"/>
    <package name="adwaita-mono-fonts"/>
  </packages>
</image>
