# Fedora module: builds our RPMs with mock into a local repo, builds the Fedora 45 live ISO for the host's architecture
# (x86_64 on the PC, aarch64 in the Mac's runner VM; nothing is cross-built) with kiwi in the pinned builder container,
# and boot-tests it under QEMU with UEFI firmware (OVMF or AAVMF). Pins live in vars.just; outputs go to
# .build/fedora/<arch>/. Image and package builds need Linux with rootless podman.

import 'vars.just'
import '../tests/vars.just'

# Build the pinned builder image (podman's layer cache makes a rebuild with unchanged pins a no-op)
builder:
  @podman build --quiet --build-arg BASE={{ builder_base }} \
    --tag {{ builder }} --file "{{ justfile_directory() }}/fedora/Containerfile" "{{ justfile_directory() }}/fedora" >/dev/null

# Build our RPMs (fedora/packages/<name>/<name>.spec) with mock into the local repo .build/fedora/repo/
packages: builder
  #!/usr/bin/env bash
  set -euo pipefail
  rm -rf "{{ repo }}"
  mkdir -p "{{ repo }}"
  # mock runs as container root in a fresh container, so every build starts clean. --isolation=simple: the container
  # has no systemd-nspawn; --no-bootstrap-image: pulling mock's bootstrap image would need podman inside the container.
  # Each spec's Source files are found by name next to the spec (Fedora-only files) and in desktop/, branding/ and
  # installer/ (base-neutral files), as `just arch packages` does. The installer's crate goes in as one tar, and its
  # build alone has mock's network, for `cargo fetch` in %prep; every other build stays offline.
  podman run --rm --privileged \
    --volume "{{ justfile_directory() }}/fedora/packages:/packages:ro" \
    --volume "{{ justfile_directory() }}/desktop:/desktop:ro" --volume "{{ justfile_directory() }}/branding:/branding:ro" \
    --volume "{{ justfile_directory() }}/installer:/installer:ro" --volume "{{ repo }}:/repo" \
    --env SOURCE_DATE_EPOCH="$(git -C "{{ justfile_directory() }}" log -1 --format=%ct)" \
    {{ builder }} bash -c 'set -euo pipefail
      mock=(mock -r fedora-45-{{ arch() }} --isolation=simple --no-bootstrap-image)
      for s in /packages/*/*.spec; do
        name=$(basename "$s" .spec)
        b=/build/$name
        mkdir -p "$b/sources"
        for f in $(sed -n "s/^Source[0-9]*:[[:space:]]*//p" "$s"); do
          find "$(dirname "$s")" /desktop /branding /installer -path /installer/target -prune -o -type f -name "$f" \
            -exec cp -t "$b/sources" {} +
        done
        net=()
        if [ "$name" = stackific-installer ]; then
          tar -C /installer --sort=name --mtime="@$SOURCE_DATE_EPOCH" --owner=0 --group=0 --numeric-owner \
            -cf "$b/sources/stackific-installer-crate.tar" Cargo.toml Cargo.lock src fixtures
          net=(--enable-network)
        fi
        "${mock[@]}" --buildsrpm --spec "$s" --sources "$b/sources" --resultdir "$b/srpm"
        "${mock[@]}" "${net[@]}" --rebuild "$b"/srpm/*.src.rpm --resultdir "$b/rpm"
        find "$b/rpm" -name "*.rpm" ! -name "*.src.rpm" -exec cp -t /repo {} +
      done
      createrepo_c --quiet /repo'

# Build .build/fedora/<arch>/stackific-<version>-fedora-<arch>.iso and its package manifest, then print the ISO size.
# Our RPMs come from the local repo `packages` fills, mounted read-only at /repo.
[positional-arguments]
iso version="0.0.0-dev": packages
  #!/usr/bin/env bash
  set -euo pipefail
  # The version reaches file names and the container only as data ($1, env), and must be semver like a release
  [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || { echo "version must be semver, got '$1'" >&2; exit 1; }
  name="stackific-$1-fedora-{{ arch() }}"
  mkdir -p "{{ out }}"
  rm -f "{{ out }}/$name.iso" "{{ out }}/$name.packages.txt"
  # kiwi's work and temp dirs are on a tmpfs that container root mounts itself: --rm discards it, so every build starts
  # fresh, and unlike podman's overlay it takes SELinux labels from rootless container root. Not podman's --tmpfs: on an
  # SELinux host (the Mac's runner VM) podman mounts it, like the overlay, with one fixed context=, so no file there can
  # be relabelled. kiwi's default temp dir, /var/tmp, is on the overlay.
  podman run --rm --privileged \
    --volume "{{ justfile_directory() }}/fedora/iso:/desc:ro" --volume "{{ repo }}:/repo:ro" --volume "{{ out }}:/out" \
    --env NAME="$name" \
    {{ builder }} bash -c 'mkdir -p /work && mount -t tmpfs tmpfs /work && mkdir /work/tmp \
      && kiwi-ng --temp-dir /work/tmp --type iso system build --description /desc --target-dir /work \
      && install -m644 /work/*.iso "/out/$NAME.iso" \
      && install -m644 /work/*.packages "/out/$NAME.packages.txt"'
  mib=$(( $(stat -c %s "{{ out }}/$name.iso") / 1048576 ))
  [ "$mib" -le 2048 ] || echo "warning: ISO is over the 2 GiB target (GitHub's per-file release cap)"
  echo "ISO: {{ out }}/$name.iso, $mib MiB (target 2048 MiB)"

# Boot-test stackific-<version>-fedora-<arch>.iso under QEMU with UEFI firmware (tests/vm/boot.sh with
# tests/vm/fedora-<arch>.sh when the architecture has its own checks, else tests/vm/fedora.sh, the checks both Fedora
# images pass); leaves screen.png (the desktop), greeter.png (the login screen after a logout) and serial.log, and on
# x86_64 gnome.png
# podman's default seccomp profile blocks AF_VSOCK sockets, which the test shell client needs. Without labelling off,
# SELinux (Fedora, as in the Mac's runner VM) keeps containers off /dev/vhost-vsock and bind mounts.
[positional-arguments]
test version="0.0.0-dev": builder
  #!/usr/bin/env bash
  set -euo pipefail
  checks=fedora.sh
  [ ! -f "{{ justfile_directory() }}/tests/vm/fedora-{{ arch() }}.sh" ] || checks="fedora-{{ arch() }}.sh"
  podman run --rm --device /dev/kvm --device /dev/vhost-vsock --security-opt seccomp=unconfined \
    --security-opt label=disable \
    --env OVMF_CODE={{ uefi_code }} --env OVMF_VARS={{ uefi_vars }} \
    --volume "{{ justfile_directory() }}/tests/vm:/tests:ro" --volume "{{ out }}:/out" \
    {{ builder }} /tests/boot.sh "/out/stackific-$1-fedora-{{ arch() }}.iso" /out "/tests/$checks"

# Install-test stackific-<version>-fedora-<arch>.iso, as `just arch test-install` does: its boot menu (Try, the default,
# and Install), then one boot with a fresh 64 GiB raw disk (tests/vm/boot.sh with tests/vm/install.sh: the console path,
# a refused erase, an erase, BIOS-mode Windows refused, a Windows-like table with BitLocker and a fake Windows, a
# free-space install), the free-space install's ESP read with mtools, and a second boot from the disk alone with the first boot's firmware variables
# (tests/vm/installed.sh). For the second boot it puts the image's limine (Terra) and kernel-core (Fedora) packages, the
# versions in the image's manifest, checked against their keys, on the installed ESP for the reinstall checks.
# Leaves installer-console.png, limine.png, installed.png and efibootmgr.txt.
[positional-arguments]
test-install version="0.0.0-dev": builder
  #!/usr/bin/env bash
  set -euo pipefail
  podman run --rm --device /dev/kvm --device /dev/vhost-vsock --security-opt seccomp=unconfined \
    --security-opt label=disable \
    --env OVMF_CODE={{ uefi_code }} --env OVMF_VARS={{ uefi_vars }} \
    --volume "{{ justfile_directory() }}/tests/vm:/tests:ro" --volume "{{ justfile_directory() }}/fedora/iso:/desc:ro" \
    --volume "{{ out }}:/out" \
    --env ISO="/out/stackific-$1-fedora-{{ arch() }}.iso" --env MANIFEST="/out/stackific-$1-fedora-{{ arch() }}.packages.txt" \
    --env STACKIFIC_TEST_DISK=/out/install-test.img \
    --env BITLK_IMAGES_URL={{ bitlk_images_url }} --env BITLK_IMAGES_SHA256={{ bitlk_images_sha256 }} \
    {{ builder }} bash -c 'set -euo pipefail
      cfg=$(bsdtar -xOf "$ISO" boot/grub2/grub.cfg)
      entry() { grep -qE -- "$1" <<<"$cfg" || { echo "FAIL: boot/grub2/grub.cfg has no line /$1/" >&2; exit 1; }; }
      entry "^set default=0\$"
      entry "^menuentry \"Try Stackific OS \({{ arch() }}, UEFI\)\""
      entry "^menuentry \"Install Stackific OS \({{ arch() }}, UEFI\)\""
      entry "linux .* systemd.unit=stackific-installer.target\$"
      [ "$(grep -m1 ^menuentry <<<"$cfg")" = "$(grep -m1 "^menuentry \"Try" <<<"$cfg")" ] || { echo "FAIL: Try is not first" >&2; exit 1; }
      echo "ok: the boot menu has Try (the default) and Install"
      rm -rf /out/pkg && mkdir /out/pkg
      # shortcut: kernel-core comes from Fedora'"'"'s repos, which keep only the newest update; rebuild the image when this
      # download fails
      nevra() { awk -F"|" -v n="$1" "\$1 == n {print n \"-\" \$3 \"-\" \$4 \".\" \$5}" "$MANIFEST"; }
      dnf -q download --destdir /out/pkg "$(nevra kernel-core)"
      dnf -q download --destdir /out/pkg --repofrompath=terra,https://repos.fyralabs.com/terra45 --repo=terra "$(nevra limine)"
      rpmkeys --import /usr/share/pki/rpm-gpg/RPM-GPG-KEY-fedora-45-primary /desc/terra-45.asc
      # Named from each header: Terra'"'"'s file name carries the epoch ("0:"), and FAT takes no colon
      for r in /out/pkg/*.rpm; do
        rpmkeys -K "$r" | grep -q "digests signatures OK" || { echo "FAIL: $r" >&2; exit 1; }
        n=$(rpm -qp --qf "%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}.rpm" "$r")
        [ "$r" = "/out/pkg/$n" ] || mv "$r" "/out/pkg/$n"
      done
      rm -f "$STACKIFIC_TEST_DISK" /out/esp-offset
      qemu-img create -q -f raw "$STACKIFIC_TEST_DISK" 64G
      /tests/boot.sh "$ISO" /out /tests/install.sh
      minfo -i "$STACKIFIC_TEST_DISK@@$(cat /out/esp-offset)" | grep -q "FAT32" || { echo "FAIL: no FAT32 at the ESP offset" >&2; exit 1; }
      echo "ok: the free-space install'"'"'s ESP is FAT32"
      mcopy -i "$STACKIFIC_TEST_DISK@@$(cat /out/esp-offset)" /out/pkg/*.rpm ::/
      OVMF_VARS=/out/vars.fd /tests/boot.sh - /out /tests/installed.sh
      rm -rf "$STACKIFIC_TEST_DISK" /out/pkg'

# Check the host prerequisites image builds need: rootless podman, and read-write /dev/kvm and /dev/vhost-vsock
check:
  #!/usr/bin/env bash
  set -euo pipefail
  if [ "{{ os() }}" = macos ]; then echo "fedora: skipped (image builds need Linux)"; exit 0; fi
  v=$(podman --version 2>/dev/null) || { echo "fedora: podman missing (docs/setup.md, host prerequisites)"; exit 1; }
  for d in /dev/kvm /dev/vhost-vsock; do
    [ -r "$d" ] && [ -w "$d" ] || { echo "fedora: $d is not read-write for $USER (docs/setup.md, host prerequisites)"; exit 1; }
  done
  echo "fedora: ok (podman ${v##* }, /dev/kvm and /dev/vhost-vsock read-write)"
