# Fedora module: builds the Fedora 45 x86_64 live ISO with kiwi in the pinned builder container and boot-tests it under
# QEMU with OVMF. Pins live in vars.just; outputs go to .build/fedora/x86_64/. Image builds need Linux with rootless podman.

import 'vars.just'

# Build the pinned builder image (podman's layer cache makes a rebuild with unchanged pins a no-op)
builder:
  @podman build --quiet --build-arg BASE={{ builder_base }} \
    --tag {{ builder }} --file "{{ justfile_directory() }}/fedora/Containerfile" "{{ justfile_directory() }}/fedora" >/dev/null

# Build .build/fedora/x86_64/stackific-<version>-fedora-x86_64.iso and its package manifest, then print the ISO size
[positional-arguments]
iso version="0.0.0-dev": builder
  #!/usr/bin/env bash
  set -euo pipefail
  # The version reaches file names and the container only as data ($1, env), and must be semver like a release
  [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || { echo "version must be semver, got '$1'" >&2; exit 1; }
  name="stackific-$1-fedora-x86_64"
  mkdir -p "{{ out }}"
  rm -f "{{ out }}/$name.iso" "{{ out }}/$name.packages.txt"
  # kiwi's work dir is a tmpfs inside the container: --rm discards it, so every build starts fresh, and unlike podman's
  # overlay it takes SELinux labels from rootless container root. podman's default tmpfs is noexec, which breaks the chroot.
  podman run --rm --privileged --tmpfs /work:rw,exec,dev,suid \
    --volume "{{ justfile_directory() }}/fedora/iso:/desc:ro" --volume "{{ out }}:/out" --env NAME="$name" \
    {{ builder }} bash -c 'kiwi-ng --type iso system build --description /desc --target-dir /work \
      && install -m644 /work/*.iso "/out/$NAME.iso" \
      && install -m644 /work/*.packages "/out/$NAME.packages.txt"'
  mib=$(( $(stat -c %s "{{ out }}/$name.iso") / 1048576 ))
  [ "$mib" -le 2048 ] || echo "warning: ISO is over the 2 GiB target (GitHub's per-file release cap)"
  echo "ISO: {{ out }}/$name.iso, $mib MiB (target 2048 MiB)"

# Boot-test stackific-<version>-fedora-x86_64.iso under QEMU with OVMF (tests/vm/boot.sh with tests/vm/fedora-x86_64.sh);
# leaves screen.png and serial.log
# podman's default seccomp profile blocks AF_VSOCK sockets, which the test shell client needs
[positional-arguments]
test version="0.0.0-dev": builder
  podman run --rm --device /dev/kvm --device /dev/vhost-vsock --security-opt seccomp=unconfined \
    --env OVMF_CODE=/usr/share/edk2/ovmf/OVMF_CODE.fd --env OVMF_VARS=/usr/share/edk2/ovmf/OVMF_VARS.fd \
    --volume "{{ justfile_directory() }}/tests/vm:/tests:ro" --volume "{{ out }}:/out" \
    {{ builder }} /tests/boot.sh "/out/stackific-$1-fedora-x86_64.iso" /out /tests/fedora-x86_64.sh

# Check the host prerequisites image builds need: rootless podman, and read-write /dev/kvm and /dev/vhost-vsock
check:
  #!/usr/bin/env bash
  set -euo pipefail
  if [ "{{ os() }}" = macos ]; then echo "fedora: skipped (image builds need Linux)"; exit 0; fi
  v=$(podman --version 2>/dev/null) || { echo "fedora: podman missing (README.md, host prerequisites)"; exit 1; }
  for d in /dev/kvm /dev/vhost-vsock; do
    [ -r "$d" ] && [ -w "$d" ] || { echo "fedora: $d is not read-write for $USER (README.md, host prerequisites)"; exit 1; }
  done
  echo "fedora: ok (podman ${v##* }, /dev/kvm and /dev/vhost-vsock read-write)"
