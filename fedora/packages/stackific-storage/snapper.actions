# Stackific OS: pre and post snapper snapshots of / around every dnf5 transaction (task 026), as snap-pac takes them on
# Arch. These are the actions dnf5's actions(8) gives to emulate DNF 4's snapper plugin, with snapper's number cleanup
# (-c number), so snapper deletes them too, and enabled=host-only, so the installer's --installroot removals take none.
pre_transaction:::enabled=host-only:/usr/bin/sh -c echo\ "tmp.snapper_descr=$(ps\ -o\ command\ --no-headers\ -p\ '${pid}')"
pre_transaction:::enabled=host-only:/usr/bin/sh -c echo\ "tmp.snapper_pre_number=$(snapper\ create\ -t\ pre\ -p\ -c\ number\ -d\ '${tmp.snapper_descr}')"
post_transaction:::enabled=host-only:/usr/bin/sh -c [\ -n\ "${tmp.snapper_pre_number}"\ ]\ &&\ snapper\ create\ -t\ post\ --pre-number\ "${tmp.snapper_pre_number}"\ -c\ number\ -d\ "${tmp.snapper_descr}"\ ;\ echo\ tmp.snapper_pre_number\ ;\ echo\ tmp.snapper_descr
