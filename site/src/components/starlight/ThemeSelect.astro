---
/**
 * Override of Starlight's ThemeSelect: the theme follows the system (see ThemeProvider.astro),
 * so this slot holds only a home icon linking to the marketing home (/), after the header separator.
 */
---

<a href="/" class="home sl-flex" aria-label="Stackific OS home">
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M3 10.5 12 3l9 7.5" />
    <path d="M5 9v12h14V9" />
    <path d="M10 21v-6h4v6" />
  </svg>
</a>

<style>
  /* Mirrors Starlight's social icon links so the icon matches the rest of the header. */
  @layer starlight.core {
    .home {
      color: var(--sl-color-text-accent);
      padding: 0.5em;
      margin: -0.5em;
    }
    .home:hover {
      color: var(--sl-color-white);
    }
    svg {
      width: 1em;
      height: 1em;
    }
  }
</style>
