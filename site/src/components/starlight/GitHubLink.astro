---
/**
 * A link to GitHub under a prompt-trail title: GitHub icon, the label, external-link icon, opened in a new tab.
 * PageTitle.astro renders one for the entry's `pr:` (the pull request) and one for its `task:` (the task file),
 * so entries carry only the paths and both links look the same.
 */
interface Props {
  /** GitHub URL. */
  href: string;
  /** Link text. */
  label: string;
}

const { href, label } = Astro.props;
---

<a class="github-link" {href} target="_blank" rel="noopener noreferrer">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.7 1.7.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z"></path>
  </svg>
  <span>{label}</span>
  <svg
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M15 3h6v6"></path>
    <path d="M10 14 21 3"></path>
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
  </svg>
</a>

<style>
  /* Each link on its own line in small text, icons centred on the text. */
  .github-link {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.4em;
    margin-top: 0.25rem;
    font-size: var(--sl-text-sm);
  }
  svg {
    flex-shrink: 0;
  }
</style>
