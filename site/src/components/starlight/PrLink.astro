---
/**
 * Link to the pull request a prompt-trail entry landed in: GitHub icon, the page title, external-link icon.
 * Rendered under the page title by PageTitle.astro when the entry's frontmatter has `pr: <url>`, so
 * entries carry only the URL and every entry's link looks the same.
 */
interface Props {
  /** Pull-request URL from the entry's frontmatter. */
  href: string;
  /** Link text: the page title. */
  label: string;
}

const { href, label } = Astro.props;
---

<a class="pr-link" {href}>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.7 1.7.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z"></path>
  </svg>
  <span>{label}</span>
  <svg
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M15 3h6v6"></path>
    <path d="M10 14 21 3"></path>
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
  </svg>
</a>

<style>
  /* Icons and text on one line, icons centred on the text. */
  .pr-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 0.5rem;
  }
  svg {
    flex-shrink: 0;
  }
</style>
