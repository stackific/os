# Stackific OS branding: the one file every branded package file renders from. A rename is one edit here and a rebuild.
# Shell syntax (KEY="value", no code), sourced by our package builds. Templates (*.in) name these keys as ${KEY}, and
# each build renders them with envsubst and an explicit list of keys, so no other `$` in a template is touched.
NAME="Stackific OS"
ID=stackific
HOME_URL="https://os.stackific.com/"
DOCUMENTATION_URL="https://os.stackific.com/docs/"
SUPPORT_URL="https://github.com/stackific/os/issues"
BUG_REPORT_URL="https://github.com/stackific/os/issues"
# The brand colour, emerald, as #RRGGBB
ACCENT="#007a55"
